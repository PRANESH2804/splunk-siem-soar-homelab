<dashboard version="1.1" theme="dark">
  <label>SOC Security Operations Center - Overview</label>
  <description>Enterprise Multi-Source SIEM + SOAR Security Operations Center</description>
  <row>
    <panel>
      <single>
        <title>Total Telemetry Events</title>
        <search>
          <query>index=security_lab | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0x006d9c"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Failed &amp; Brute Force Logins</title>
        <search>
          <query>index=security_lab ("Failed login" OR "failed password" OR "EventID=4625") | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[1,5]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Sysmon &amp; Suspicious Commands</title>
        <search>
          <query>index=security_lab (app="sysmon" OR message="*powershell*" OR message="*outbound connection*") | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Malware &amp; Hash Detections</title>
        <search>
          <query>index=security_lab (app=antivirus OR message="*malware*" OR message="*Trojan*" OR message="*CobaltStrike*") | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>FIM &amp; Web Attacks</title>
        <search>
          <query>index=security_lab (app="fim" OR app="nginx:access") | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>SOAR Automated Containments</title>
        <search>
          <query>index=security_lab app=soar | stats count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0x006d9c"]</option>
        <option name="rangeValues">[0]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Telemetry Ingestion by Source Component</title>
        <search>
          <query>index=security_lab | fillnull value="other" app | stats count by app</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">pie</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Security Incidents &amp; Alerts Over Time</title>
        <search>
          <query>index=security_lab | fillnull value="system" app | timechart count by app</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <title>Top Suspicious IP Indicators</title>
        <search>
          <query>index=security_lab | rex field=message "(?:from\s+(?&lt;src_ip&gt;\d+\.\d+\.\d+\.\d+)|IpAddress=\"(?&lt;src_ip&gt;\d+\.\d+\.\d+\.\d+)\"|SourceIp=\"(?&lt;src_ip&gt;\d+\.\d+\.\d+\.\d+)\"|DestinationIp=\"(?&lt;src_ip&gt;\d+\.\d+\.\d+\.\d+)\")" | where isnotnull(src_ip) AND src_ip!="127.0.0.1" | stats count, values(app) as source_sources, values(message) as sample_evidence by src_ip | sort - count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="count">8</option>
      </table>
    </panel>
    <panel>
      <table>
        <title>Latest Live Security &amp; SOAR Feedback Stream</title>
        <search>
          <query>index=security_lab | table _time, host, app, severity, message | sort - _time</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="count">8</option>
      </table>
    </panel>
  </row>
</dashboard>
